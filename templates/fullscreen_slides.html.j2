{% extends 'reveal/index.html.j2' %}

{% block notebook_css %}
{{ super() }}
<style>
/* Fill the browser window without reserving notebook execution-prompt gutters. */
:root {
  --jp-content-font-size1: clamp(22px, 1.6vw, 32px);
  --jp-ui-font-size1: clamp(20px, 1.4vw, 28px);
  --jp-code-font-size: clamp(18px, 1.2vw, 24px);
  --jp-cell-prompt-width: 0px;
  --jp-notebook-padding: 0px;
  --jp-cell-padding: 0px;
}

.reveal .jp-InputPrompt,
.reveal .jp-OutputPrompt,
.reveal .jp-Collapser {
  display: none;
}

.reveal .jp-RenderedHTMLCommon {
  padding-left: 0;
  padding-right: 0;
  max-width: none;
}

.reveal .jp-RenderedHTMLCommon h1 {
  font-size: calc(2 * var(--jp-content-font-size1));
}

.reveal .jp-RenderedHTMLCommon h2 {
  font-size: calc(1.6 * var(--jp-content-font-size1));
}

.reveal .jp-RenderedHTMLCommon h3 {
  font-size: calc(1.3 * var(--jp-content-font-size1));
}

.reveal .slides section {
  box-sizing: border-box;
  padding: 0;
}

.reveal .slides > section:not(.stack),
.reveal .slides > section.stack > section {
  width: 90%;
  height: auto;
  left: 0;
  right: 0;
  margin: 0 auto;
}

{% if resources.reveal.scroll %}
/* Scroll each actual slide, leaving vertical slide-stack containers alone. */
.reveal .slides > section:not(.stack),
.reveal .slides > section.stack > section {
  max-height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
}
{% endif %}
</style>
{% endblock notebook_css %}

{% block footer_js %}
<script>
require(
  { waitSeconds: 15 },
  [
    '{{ reveal_url_prefix }}/dist/reveal.js',
    '{{ reveal_url_prefix }}/plugin/notes/notes.js'
  ],
  function(Reveal, RevealNotes) {
    function updateMath() {
      if (window.MathJax && MathJax.Hub) {
        MathJax.Hub.Queue(
          ['Rerender', MathJax.Hub, Reveal.getCurrentSlide()],
          function() { Reveal.layout(); }
        );
      }
    }

    Reveal.addEventListener('ready', updateMath);
    Reveal.addEventListener('slidechanged', updateMath);

    Reveal.initialize({
      controls: true,
      progress: true,
      history: true,
      transition: '{{ reveal_transition }}',
      slideNumber: '{{ reveal_number }}',
      plugins: [RevealNotes],
      // Percentage dimensions follow the window's current aspect ratio.
      width: '100%',
      height: '100%',
      margin: 0.025,
      center: true,
      minScale: 1,
      maxScale: 1
    });
  }
);
</script>
{% endblock footer_js %}
